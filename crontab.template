VESTABOARD_DIR={{VESTABOARD_DIR}}
VESTABOARD_LOG={{VESTABOARD_DIR}}/vestaboard.log
PATH=/usr/local/bin:/usr/bin:/bin
TZ=America/Los_Angeles

# Rain, pollen, and air quality skip posting when levels are trivial if --skip-trivial is passed.
# Run manually without the flag to always send (good for testing).
# All output is logged to $VESTABOARD_LOG — tail -f it to watch live.

# ── Weather (daytime backbone, 8am–7:30pm) ───────────────────────
*/30 8-19 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') weather" >> $VESTABOARD_LOG && {{NOTE_BIN}} weather >> $VESTABOARD_LOG 2>&1

# ── Morning ───────────────────────────────────────────────────────
0  9 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') uv" >> $VESTABOARD_LOG && {{NOTE_BIN}} uv --skip-trivial >> $VESTABOARD_LOG 2>&1
0 11 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') pollen" >> $VESTABOARD_LOG && {{NOTE_BIN}} pollen --skip-trivial >> $VESTABOARD_LOG 2>&1
0 12 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') rain" >> $VESTABOARD_LOG && {{NOTE_BIN}} rain --skip-trivial >> $VESTABOARD_LOG 2>&1

# ── Afternoon ─────────────────────────────────────────────────────
0 13 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') calendar" >> $VESTABOARD_LOG && {{NOTE_BIN}} calendar >> $VESTABOARD_LOG 2>&1
0 15 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') season" >> $VESTABOARD_LOG && {{NOTE_BIN}} season >> $VESTABOARD_LOG 2>&1
0 16 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') holiday" >> $VESTABOARD_LOG && {{NOTE_BIN}} holiday --skip-trivial >> $VESTABOARD_LOG 2>&1
0 17 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') air" >> $VESTABOARD_LOG && {{NOTE_BIN}} air --skip-trivial >> $VESTABOARD_LOG 2>&1
0 18 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') suntime" >> $VESTABOARD_LOG && {{NOTE_BIN}} suntime >> $VESTABOARD_LOG 2>&1
0 19 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') satellites" >> $VESTABOARD_LOG && {{NOTE_BIN}} satellites --skip-trivial >> $VESTABOARD_LOG 2>&1

# ── Evening (no weather, each slot owns the full hour) ────────────
0 20 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') holiday" >> $VESTABOARD_LOG && {{NOTE_BIN}} holiday --skip-trivial >> $VESTABOARD_LOG 2>&1
0 21 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') moonphase" >> $VESTABOARD_LOG && {{NOTE_BIN}} moonphase >> $VESTABOARD_LOG 2>&1
0 22 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') season" >> $VESTABOARD_LOG && {{NOTE_BIN}} season >> $VESTABOARD_LOG 2>&1

# ── Overnight ────────────────────────────────────────────────────
# 11pm: show today's date. Midnight: flip to tomorrow's date.
0 23 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') tearoff" >> $VESTABOARD_LOG && {{NOTE_BIN}} tearoff >> $VESTABOARD_LOG 2>&1
0  0 * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') tearoff" >> $VESTABOARD_LOG && {{NOTE_BIN}} tearoff >> $VESTABOARD_LOG 2>&1
