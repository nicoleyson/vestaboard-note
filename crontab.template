VESTABOARD_DIR={{VESTABOARD_DIR}}
VESTABOARD_LOG={{VESTABOARD_DIR}}/vestaboard.log
PATH=/usr/local/bin:/usr/bin:/bin

# Quiet hours are enforced by the binary via quiet_hours in config.yaml.
# Cron fires every job every hour; the binary exits silently outside active hours.
# This makes the schedule timezone-independent — no TZ variable needed.

# ── Weather (every 30 min) ────────────────────────────────────────
*/30 * * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') weather" >> $VESTABOARD_LOG && {{NOTE_BIN}} weather >> $VESTABOARD_LOG 2>&1

# ── Hourly slots ──────────────────────────────────────────────────
 0 * * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') uv" >> $VESTABOARD_LOG && {{NOTE_BIN}} uv --skip-trivial >> $VESTABOARD_LOG 2>&1
 5 * * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') pollen" >> $VESTABOARD_LOG && {{NOTE_BIN}} pollen --skip-trivial >> $VESTABOARD_LOG 2>&1
10 * * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') rain" >> $VESTABOARD_LOG && {{NOTE_BIN}} rain --skip-trivial >> $VESTABOARD_LOG 2>&1
15 * * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') calendar" >> $VESTABOARD_LOG && {{NOTE_BIN}} calendar >> $VESTABOARD_LOG 2>&1
20 * * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') season" >> $VESTABOARD_LOG && {{NOTE_BIN}} season >> $VESTABOARD_LOG 2>&1
25 * * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') holiday" >> $VESTABOARD_LOG && {{NOTE_BIN}} holiday --skip-trivial >> $VESTABOARD_LOG 2>&1
35 * * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') air" >> $VESTABOARD_LOG && {{NOTE_BIN}} air --skip-trivial >> $VESTABOARD_LOG 2>&1
40 * * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') suntime" >> $VESTABOARD_LOG && {{NOTE_BIN}} suntime >> $VESTABOARD_LOG 2>&1
45 * * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') satellites" >> $VESTABOARD_LOG && {{NOTE_BIN}} satellites --skip-trivial >> $VESTABOARD_LOG 2>&1
50 * * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') moonphase" >> $VESTABOARD_LOG && {{NOTE_BIN}} moonphase >> $VESTABOARD_LOG 2>&1
55 * * * * {{USER}}cd $VESTABOARD_DIR && echo "$(date '+\%Y-\%m-\%d \%H:\%M') tearoff" >> $VESTABOARD_LOG && {{NOTE_BIN}} tearoff >> $VESTABOARD_LOG 2>&1
