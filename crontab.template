VESTABOARD_DIR={{VESTABOARD_DIR}}
VESTABOARD_LOG={{VESTABOARD_DIR}}/vestaboard.log
PATH=/usr/local/bin:/usr/bin:/bin

# All times are America/Los_Angeles (PDT/PST). Server timezone is set to America/Los_Angeles
# via: sudo timedatectl set-timezone America/Los_Angeles
# DST is handled automatically by the OS — no need to update this file for daylight saving.
# Rain, pollen, air skip posting when trivial with --skip-trivial.
# All output logged to $VESTABOARD_LOG — tail -f to watch live.

# ── Weather: every 30min, 8am–7:30pm ─────────────────────────────
*/30 8-19 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') weather" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} weather >> {{VESTABOARD_LOG}} 2>&1

# ── Morning ───────────────────────────────────────────────────────
0  9 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') uv" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} uv --skip-trivial >> {{VESTABOARD_LOG}} 2>&1
0 11 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') pollen" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} pollen --skip-trivial >> {{VESTABOARD_LOG}} 2>&1
0 12 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') rain" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} rain --skip-trivial >> {{VESTABOARD_LOG}} 2>&1

# ── Afternoon ─────────────────────────────────────────────────────
0 13 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') calendar" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} calendar >> {{VESTABOARD_LOG}} 2>&1
0 15 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') season" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} season >> {{VESTABOARD_LOG}} 2>&1
0 16 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') holiday" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} holiday >> {{VESTABOARD_LOG}} 2>&1
0 17 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') air" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} air --skip-trivial >> {{VESTABOARD_LOG}} 2>&1
0 18 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') suntime" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} suntime >> {{VESTABOARD_LOG}} 2>&1
0 19 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') satellites" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} satellites --skip-trivial >> {{VESTABOARD_LOG}} 2>&1

# ── Evening ───────────────────────────────────────────────────────
0 20 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') holiday" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} holiday >> {{VESTABOARD_LOG}} 2>&1
0 21 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') moonphase" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} moonphase >> {{VESTABOARD_LOG}} 2>&1
0 22 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') season" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} season >> {{VESTABOARD_LOG}} 2>&1

# ── Overnight ─────────────────────────────────────────────────────
0 23 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') tearoff" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} tearoff >> {{VESTABOARD_LOG}} 2>&1
0  0 * * * cd {{VESTABOARD_DIR}} && echo "$(date '+%Y-%m-%d %H:%M %Z') tearoff" >> {{VESTABOARD_LOG}} && {{NOTE_BIN}} tearoff >> {{VESTABOARD_LOG}} 2>&1
