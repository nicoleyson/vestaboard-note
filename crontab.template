VESTABOARD_DIR={{VESTABOARD_DIR}}

# Rain, pollen, and air quality skip posting when levels are trivial if --skip-trivial is passed.
# Run manually without the flag to always send (good for testing).

# ── Weather (daytime backbone, 8am–7:30pm) ───────────────────────
*/30 8-19 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} weather

# ── Morning ───────────────────────────────────────────────────────
0  9 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} onthisday
0 10 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} pollen --skip-trivial
0 11 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} rain --skip-trivial
0 12 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} uv

# ── Afternoon ─────────────────────────────────────────────────────
0 13 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} onthisday
0 14 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} calendar
0 15 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} season
0 16 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} holiday --skip-trivial
0 17 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} air --skip-trivial
0 18 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} suntime
0 19 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} satellites --skip-trivial

# ── Evening (no weather, each slot owns the full hour) ────────────
0 20 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} holiday --skip-trivial
0 21 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} moonphase
0 22 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} season

# ── Overnight ────────────────────────────────────────────────────
0 23 * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} tearoff
