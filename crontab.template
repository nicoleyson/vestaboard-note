VESTABOARD_DIR={{VESTABOARD_DIR}}

# Rain, pollen, and air quality skip posting when levels are trivial if --skip-trivial is passed.
# Run manually without the flag to always send (good for testing).

# ── Weather backbone ─────────────────────────────────────────────
# Weather every 30 minutes. Board always returns to weather within
# 30 minutes after any one-shot subcommand below.
*/30 * * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} weather

# ── One-shots at :05 (25 min visible before weather reclaims) ────
5  9  * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} onthisday
5 10  * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} calendar
5 11  * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} rain --skip-trivial
5 12  * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} uv
5 13  * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} onthisday
5 14  * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} season
5 15  * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} holiday --skip-trivial
5 16  * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} air --skip-trivial
5 17  * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} suntime
5 18  * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} satellites --skip-trivial
5 19  * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} pollen --skip-trivial
5 20  * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} holiday --skip-trivial
5 21  * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} moonphase

# ── Screensaver ──────────────────────────────────────────────────
# Tear-off calendar at midnight — stays up until weather reclaims the board at 12:30am
0  0  * * * {{USER}}cd $VESTABOARD_DIR && {{NOTE_BIN}} tearoff
